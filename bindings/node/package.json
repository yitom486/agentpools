{
  "name": "agentpools",
  "version": "0.1.7",
  "description": "Bounded multi-runtime agent session pools for Node.js",
  "main": "index.js",
  "types": "api.d.ts",
  "files": [
    "index.js",
    "api.d.ts"
  ],
  "scripts": {
    "build": "napi build --platform --release --no-js --dts native.d.ts",
    "test": "node --test",
    "release:collect": "napi artifacts --output-dir ./artifacts --npm-dir ./npm",
    "release:prepare": "napi pre-publish --skip-optional-publish --no-gh-release"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "napi": {
    "binaryName": "agentpools",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin"
    ]
  }
}
